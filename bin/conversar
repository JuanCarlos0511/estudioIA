#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if (( $# != 1 )); then
    echo 'Uso: ./bin/conversar <nombre_corto>' >&2
    echo 'bitnet-2b | falcon3-3b-ternario | bonsai2-2b-ternario | falcon3-3b-q4 | qwen2.5-1.5b-q4 | qwen3.5-2b-q4' >&2
    exit 2
fi
engine="$root/runtimes/llama.cpp/build/bin/llama-cli"
extra=()
case "$1" in
    bitnet-2b)
        engine="$root/runtimes/BitNet/build/bin/llama-cli"
        model="$root/modelos/bitnet-2b/ggml-model-i2_s.gguf" ;;
    falcon3-3b-ternario)
        engine="$root/runtimes/BitNet/build/bin/llama-cli"
        model="$root/modelos/falcon3-3b-ternario/ggml-model-i2_s.gguf" ;;
    bonsai2-2b-ternario)
        model="$root/modelos/bonsai2-2b-ternario/Ternary-Bonsai-2-2B-Q2_0.gguf"
        extra=(--chat-template-kwargs '{"enable_thinking":false}') ;;
    falcon3-3b-q4)
        model="$root/modelos/falcon3-3b-q4/Falcon3-3B-Instruct-q4_k_m.gguf" ;;
    qwen2.5-1.5b-q4)
        model="$root/modelos/qwen2.5-1.5b-q4/qwen2.5-1.5b-instruct-q4_k_m.gguf" ;;
    qwen3.5-2b-q4)
        model="$root/modelos/qwen3.5-2b-q4/Qwen3.5-2B-Q4_K_M.gguf"
        extra=(--chat-template-kwargs '{"enable_thinking":false}') ;;
    *) echo "Modelo desconocido: $1" >&2; exit 2 ;;
esac
if [[ ! -x "$engine" || ! -s "$model" ]]; then
    echo "Instalación pendiente para $1. Consulta INSTALACION.md." >&2
    exit 1
fi
exec "$engine" -m "$model" -cnv --jinja -c 2048 -n 512 -t 16 -ngl 0 --temp 0 --top-k 1 --seed 42 "${extra[@]}"
